{
  "expo": {
    "name": "NurseFinder",
    "slug": "nurse-finder",
    "version": "1.0.0",
    "scheme": "nursefinder",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0EA5E9"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nursefinder.app",
      "config": {
        "googleMapsApiKey": "TU_CLAVE_IOS_AQUI"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NurseFinder necesita tu ubicación para mostrar enfermeros cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "NurseFinder necesita tu ubicación para que los clientes te encuentren.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tu galería para subir documentos y foto de perfil.",
        "NSCameraUsageDescription": "Necesitamos acceso a tu cámara para tomar fotos de documentos."
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCvG1r0DXWQrkFLUL5aqmAV4w6xvJ5qwVI"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0EA5E9"
      },
      "package": "com.nursefinder.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "NurseFinder necesita tu ubicación para que los clientes te encuentren."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Necesitamos acceso a tu galería para subir documentos."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "6825014d-eb66-4f9a-a819-490340ba389c"
      }
    }
  }
}
